generator client {
  provider = "prisma-client-js"
  // "native" cobre a maquina onde o `prisma generate` roda. Os alvos Debian
  // sao para o caso de o build acontecer em ambiente diferente do de execucao
  // (Linux com OpenSSL 1.1 ou 3.x, o par mais comum em hospedagem).
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseDifficulty {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum LessonType {
  VIDEO
  PDF
  TEXT
}

enum VideoSource {
  UPLOAD
  EMBED
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
  courses   Course[]
  obrigatorios CursoObrigatorio[]
  provas    Prova[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  active       Boolean  @default(true)
  position     String? // cargo
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  avatarUrl    String?
  lastLoginAt  DateTime?

  /// Matricula do funcionario. E o mesmo numero usado na intranet, para que a
  /// mesma pessoa seja reconhecivel nos dois sistemas.
  matricula    String?  @unique
  /// Id do funcionario no cadastro da intranet. E por ele que a sincronizacao
  /// reencontra a pessoa mesmo que nome, e-mail ou matricula mudem la.
  intranetEmployeeId String? @unique
  /// Quando veio da intranet, guarda a data da ultima sincronizacao. Nulo
  /// significa cadastro feito direto aqui.
  syncedAt     DateTime?
  /// Senha provisoria: bloqueia o uso da plataforma ate a troca.
  mustChangePassword Boolean @default(false)

  /// Conta protegida ("proprietário"): só o próprio dono pode alterá-la.
  ///
  /// Um administrador comum enxerga a conta e o histórico dela, mas não
  /// consegue desativar, editar nem redefinir a senha. Só quem já é protegido
  /// pode conceder ou retirar esta marca — sem isso, bastaria desmarcar antes
  /// de atacar, e a proteção não valeria nada.
  protegido      Boolean  @default(false)

  /// Tentativas de senha erradas seguidas. Zera a cada login bem-sucedido.
  failedAttempts Int      @default(0)
  /// Enquanto no futuro, o login e recusado mesmo com a senha correta.
  lockedUntil    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdCourses    Course[]           @relation("CourseCreatedBy")
  enrollments       Enrollment[]       @relation("EnrollmentUser")
  assignedEnrollments Enrollment[]     @relation("EnrollmentAssignedBy")
  lessonProgress    LessonProgress[]
  courseProgress    CourseProgress[]
  certificates      Certificate[]
  passwordResets    PasswordResetToken[]
  accessLogs        AccessLog[]
  adminActivity     AdminActivityLog[]
  uploadedFiles     FileAsset[]
  provasCriadas     Prova[]            @relation("ProvaCriadaPor")
  tentativasProva   TentativaProva[]
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model FileAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  kind         String // VIDEO | PDF | COVER | AVATAR
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  coverForCourses Course[] @relation("CourseCover")
  videoForLessons Lesson[] @relation("LessonVideo")
  pdfForLessons   Lesson[] @relation("LessonPdf")
}

model Course {
  id                 String           @id @default(cuid())
  title              String
  description        String
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id])
  instructor         String?
  coverFileId        String?
  coverFile          FileAsset?       @relation("CourseCover", fields: [coverFileId], references: [id])
  durationMinutes    Int              @default(0)
  difficulty         CourseDifficulty @default(INICIANTE)
  status             CourseStatus     @default(DRAFT)
  sequential         Boolean          @default(false)
  allowDownload      Boolean          @default(true)
  certificateEnabled Boolean          @default(true)
  videoCompletionThreshold Int        @default(90)
  /// Departamento dono do curso. Define quem pode alterá-lo: um administrador
  /// comum só mexe nos cursos do seu departamento. Nulo significa que o curso
  /// nao foi atribuido a nenhum — nesse estado, so o proprietario pode altera-lo.
  departmentId       String?
  department         Department?      @relation(fields: [departmentId], references: [id])
  createdById        String
  createdBy          User             @relation("CourseCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  modules         Module[]
  obrigatorios    CursoObrigatorio[]
  enrollments     Enrollment[]
  courseProgress  CourseProgress[]
  certificates    Certificate[]

  @@index([status])
}

/// Curso obrigatorio para um departamento inteiro.
///
/// Existe para que ninguem precise matricular pessoa por pessoa: marcado aqui,
/// o curso alcanca quem ja esta no departamento e quem entrar depois.
///
/// A matricula continua sendo uma linha em Enrollment — esta tabela diz apenas
/// QUEM deve estar matriculado, e a sincronizacao cria o que falta. Assim o
/// progresso, o certificado e a remocao individual seguem funcionando igual.
model CursoObrigatorio {
  id           String     @id @default(cuid())
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// Dias a partir da matricula para concluir. Nulo significa sem prazo.
  prazoDias    Int?
  createdAt    DateTime   @default(now())

  @@unique([courseId, departmentId])
  @@index([departmentId])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  createdAt DateTime @default(now())

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id           String      @id @default(cuid())
  moduleId     String
  module       Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  order        Int
  type         LessonType
  required     Boolean     @default(true)

  videoSource  VideoSource?
  videoFileId  String?
  videoFile    FileAsset?  @relation("LessonVideo", fields: [videoFileId], references: [id])
  videoEmbedUrl String?
  videoDurationSeconds Int?

  pdfFileId    String?
  pdfFile      FileAsset?  @relation("LessonPdf", fields: [pdfFileId], references: [id])

  textContent  String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  progress LessonProgress[]

  @@index([moduleId])
}

model Enrollment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("EnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mandatory    Boolean   @default(false)
  dueDate      DateTime?
  assignedById String?
  assignedBy   User?     @relation("EnrollmentAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId           String
  lesson             Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed          Boolean   @default(false)
  completedAt        DateTime?
  videoPositionSeconds Int?
  videoWatchedPercent  Int?
  /// Tempo real acumulado de reprodução. Só cresce com o relógio do servidor,
  /// então não é possível "assistir" um vídeo mais rápido do que ele dura.
  videoWatchedSeconds  Int       @default(0)
  updatedAt          DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

model CourseProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  percent     Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
}

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code            String   @unique
  issuedAt        DateTime @default(now())

  @@unique([userId, courseId])
}

/// Tentativas de login, para limitar por origem e para a trilha de auditoria.
///
/// Guarda o e-mail tentado mesmo quando a conta nao existe: sem isso, alguem
/// varrendo enderecos passaria despercebido. Registros antigos sao descartados
/// pela propria rotina de verificacao.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String   @default("")
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AccessLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model AdminActivityLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([adminId])
}

/// Prova: avaliação de conhecimento, independente de curso.
///
/// Segue o mesmo dono que o curso — o departamento — porque a regra de quem
/// pode criar, editar e excluir precisa ser a mesma da plataforma inteira.
/// Prova sem departamento fica reservada ao proprietário, exatamente como um
/// curso sem departamento.
model Prova {
  id           String      @id @default(cuid())
  titulo       String
  descricao    String?

  /// Dono da prova. Nulo = só o proprietário altera.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  /// Percentual de acerto exigido para aprovação.
  notaMinima   Int         @default(70)

  /// Rascunho não aparece para o funcionário. Mesma lógica do curso: a prova
  /// é montada aos poucos e só fica visível quando quem escreveu decide.
  publicada    Boolean     @default(false)

  createdById  String
  createdBy    User        @relation("ProvaCriadaPor", fields: [createdById], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  questoes     QuestaoProva[]
  tentativas   TentativaProva[]

  @@index([departmentId])
}

model QuestaoProva {
  id           String   @id @default(cuid())
  provaId      String
  prova        Prova    @relation(fields: [provaId], references: [id], onDelete: Cascade)
  enunciado    String
  ordem        Int      @default(0)
  alternativas AlternativaProva[]

  @@index([provaId])
}

model AlternativaProva {
  id        String       @id @default(cuid())
  questaoId String
  questao   QuestaoProva @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  texto     String
  correta   Boolean      @default(false)
  ordem     Int          @default(0)

  @@index([questaoId])
}

/// Uma realização da prova por um funcionário.
///
/// Guarda o resultado JÁ CALCULADO — nota, acertos e total — em vez de
/// recalcular a partir das respostas quando alguém consulta. A razão é que a
/// prova muda: questão corrigida, alternativa reescrita, prova reformulada.
/// Recalcular depois daria uma nota diferente da que a pessoa recebeu na hora,
/// e a nota registrada é o que vale para conformidade.
model TentativaProva {
  id        String   @id @default(cuid())
  provaId   String
  prova     Prova    @relation(fields: [provaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nota      Int
  acertos   Int
  total     Int
  aprovado  Boolean
  /// Congela o gabarito daquele momento: questão, alternativa escolhida e se
  /// estava certa. Sem isso não há como mostrar ao funcionário o que ele errou
  /// depois que a prova for editada.
  respostas String

  createdAt DateTime @default(now())

  @@index([userId, provaId])
  @@index([provaId])
}
