# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# prisma / database
# O padrão cobre dev.db e qualquer backup: bancos contêm e-mails e hashes de
# senha dos usuários e não devem ser versionados.
/prisma/*.db
/prisma/*.db-journal
/prisma/*.sqlite

# uploaded files (kept locally, not versioned)
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/videos/.gitkeep
!/storage/uploads/pdfs/.gitkeep
!/storage/uploads/covers/.gitkeep
!/storage/uploads/avatars/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts
