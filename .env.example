# =====================================================================
#  Academia Corporativa Tri Hotéis — configuração
#
#  Copie para .env e ajuste. O .env NÃO vai para o repositório.
#
#  Em produção (NODE_ENV=production), o servidor RECUSA subir se
#  NEXTAUTH_URL, NEXTAUTH_SECRET ou STORAGE_DIR faltarem — as três
#  falham em silêncio se passarem despercebidas.
# =====================================================================

# ---------------------------------------------------------------- Banco
# SQLite. EM PRODUÇÃO, aponte para FORA da pasta do projeto: hospedagem
# que publica substituindo o diretório da aplicação apaga tudo que
# estiver dentro dele — matrículas, progresso e certificados junto.
#
#   desenvolvimento:  file:./dev.db          (vira prisma/dev.db)
#   produção:         file:/home/usuario/dados-faculdade/dev.db
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------- Arquivos enviados
# Vídeos, PDFs e capas das aulas. Mesmo cuidado do banco: em produção,
# FORA da pasta do projeto. Em branco, usa ./storage/uploads.
#
#   produção:  /home/usuario/dados-faculdade/uploads
STORAGE_DIR=""

# Limite por arquivo enviado, em MB. A hospedagem pode ter um teto
# próprio no corpo da requisição — teste um vídeo grande após publicar.
UPLOAD_MAX_SIZE_MB="500"

# ------------------------------------------------------------- Autenticação
# Endereço público real da plataforma. Sem ele o NextAuth assume
# http://localhost:3000 e o login devolve o usuário para a máquina
# errada. Em desenvolvimento pode ficar em branco: scripts/servidor.mjs
# detecta o IP da rede a cada inicialização.
#
#   produção:  https://faculdade.trihoteis.com.br
NEXTAUTH_URL=""

# Assina os cookies de sessão. Mínimo de 32 caracteres, gerado por você:
# quem souber este valor fabrica uma sessão de administrador.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_SECRET=""

# ------------------------------------------------- Proteção do login
# Erros de senha seguidos que bloqueiam a conta, e por quantos minutos.
MAX_FAILED_ATTEMPTS="5"
LOCKOUT_MINUTES="15"

# Teto de tentativas malsucedidas por origem, na janela indicada. Barra quem
# varre muitas contas com poucas tentativas em cada.
LOGIN_IP_LIMIT="30"
LOGIN_IP_WINDOW_MINUTES="5"

# Ligue APENAS se houver um proxy reverso real na frente (nginx, Cloudflare).
# O x-forwarded-for é escrito pelo cliente: sem proxy, qualquer um o forja,
# escolhe o próprio balde de limite e escapa da barreira por origem.
TRUST_PROXY="false"

# ------------------------------------------------- Integração com a intranet
# OPCIONAL e desligada por padrão. Preenchida, habilita em
# "Funcionários" o bloco que espelha o cadastro da intranet com a mesma
# matrícula. Em branco, a plataforma é totalmente independente e nada
# na interface menciona um segundo sistema.
#
# Exige Node 22.5+ (módulo node:sqlite) e que o arquivo esteja acessível
# a esta aplicação. Leitura apenas — nada é escrito na intranet.
INTRANET_DB_PATH=""

# ------------------------------------------------------------------ Servidor
# Porta HTTP. A hospedagem geralmente define esta variável sozinha.
PORT="3000"

# ================================================================= E-mail
# OPCIONAL. Sem estas variáveis a plataforma funciona igual ao que era
# antes: o administrador entrega senha e link de redefinição à mão.
#
# O login desta plataforma é um NOME DE USUÁRIO, e a rede não tem e-mail
# corporativo. O endereço é pessoal, opcional, e quem o cadastra é a
# própria pessoa em Perfil -> Meu e-mail. Com SMTP configurado:
#   - a pessoa confirma o endereço pelo link e passa a conseguir
#     recuperar a senha sozinha, sem procurar o RH;
#   - "esqueci minha senha" envia o link para o endereço confirmado;
#   - redefinição feita pelo painel avisa quem tem endereço.
#
# NENHUM e-mail sai no cadastro do funcionário: naquele momento a conta
# ainda não tem endereço nenhum. A senha provisória é entregue em mãos.
#
# ATENÇÃO AO DOMÍNIO: os endereços serão Gmail, Hotmail e Outlook. Sem
# SPF, DKIM e DMARC configurados no domínio remetente, a confirmação e o
# link de redefinição caem no spam — e o recurso parece simplesmente não
# funcionar, sem nenhuma mensagem de erro em lugar nenhum. Confira isso
# com quem cuida do DNS ANTES de anunciar o recurso à rede.
#
# Precisa das CINCO para ligar. Faltando uma, o envio fica desligado —
# de propósito: melhor não enviar do que falhar a cada cadastro.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Academia Tri Hotéis <nao-responda@trihoteis.com.br>"
# Força TLS na conexão. Em branco, liga sozinho na porta 465.
SMTP_SECURE=""

# ============================================ Resumo de conformidade
# OPCIONAL. Para onde vai o resumo semanal dos treinamentos obrigatórios
# em atraso ou vencendo. Usa o SMTP acima.
#
# A tela /admin/conformidade já responde a essa pergunta; o resumo existe
# porque ela depende de alguém LEMBRAR de abri-la, e treinamento vencido
# não avisa que venceu.
#
# Envie por agendador (cron, Agendador de Tarefas):
#   0 8 * * 1  cd /caminho/do/projeto && npm run conformidade:resumo
#
# Sem nada em atraso nem vencendo, nenhum e-mail é enviado — de propósito:
# um resumo que chega toda semana dizendo "está tudo bem" ensina quem
# recebe a arquivá-lo sem ler.
RESUMO_CONFORMIDADE_EMAIL=""

# ========================================================== Monitoramento
# OPCIONAL. Para onde vai o aviso quando uma tela quebra em produção.
# Sem isto, o erro só fica no log — que foi como a última quebra passou
# despercebida até alguém abrir a página.
#
# O e-mail usa o SMTP acima; o webhook aceita qualquer endpoint que
# receba POST com JSON (Slack, Discord, n8n, o que houver).
ALERTA_EMAIL=""
ALERTA_WEBHOOK_URL=""
# Minutos de silêncio por tipo de erro, para uma página quebrada não
# gerar um aviso por acesso.
ALERTA_INTERVALO_MIN="30"

# ==================================================== Registro de erros
# Onde ficam gravadas as falhas do servidor, uma linha JSON por erro. É o
# que a tela /admin/erros lê — e a razão de ela existir: o stderr da
# hospedagem chegou vazio quando fomos procurar o rastro de uma quebra, e
# sem isso o "Código para o suporte" que o usuário informa não leva a
# lugar nenhum.
#
# Em branco, grava em ../erros a partir de STORAGE_DIR. Precisa ficar FORA
# da pasta publicada: publicar substitui a aplicação, e é justamente
# depois de publicar que se quer olhar o histórico.
ERROS_DIR=""
# Dias de histórico. Os arquivos mais antigos são apagados sozinhos.
ERROS_DIAS="30"
# Teto de avisos que o NAVEGADOR pode registrar por minuto, somando todos os
# visitantes. A rota que os recebe não tem autenticação de propósito — a tela
# pode ter quebrado justamente no caminho da sessão —, e sem teto um laço de
# requisições enche o disco com o registro de erros.
ERROS_CLIENTE_LIMITE="60"

# =============================================================== Backup
# Rode com "npm run backup" (scripts/backup.mjs). Ele copia o banco e os
# arquivos enviados JUNTOS — um sem o outro não restaura.
#
# Quantos backups manter. O script apaga os mais antigos além disto,
# senão um backup diário enche o disco em poucos meses.
BACKUP_KEEP="14"
# Destino. Em branco, grava em ./backups.
BACKUP_DIR=""

# ============================================================ Migração
# As migrações rodam no postinstall quando NODE_ENV=production. Algumas
# hospedagens não definem NODE_ENV durante a instalação de dependências —
# nesse caso defina esta variável para que o banco acompanhe cada
# publicação. Sem isso, publicar código que espera coluna nova quebra as
# telas novas até alguém rodar "prisma migrate deploy" à mão.
MIGRAR_NA_INSTALACAO="1"
